@incollection{drobner_transmission_2012,
	title = {The {Transmission} of {Augustine}'s {Sermons}. {A} {Critical} {Assessment}},
	url = {https://www.brepolsonline.net/content/books/10.1484/M.IPM-EB.1.101272},
	doi = {10.1484/M.IPM-EB.1.101272},
	abstract = {It has always been known that the general state of the transmission of Augustine\&apos;s sermons is a highly fragmentary one, and that all conclusions drawn from them therefore must remain incomplete. In addition, the discovery of the Sermones Moguntini in 1990 has made it clear that one can no longer accept the integrity of any sermon without hesitation because it seems that medieval redactors shaped the transmission much more towards their own ends than hitherto suspected. This new realization also leads one to question the reliability and historical meaning of series of sermons and all conclusions based on them such as Augustine\&apos;s travels, the liturgy he celebrated, and even some dates of his biography, which may have to be reconsidered. Nevertheless, awareness of the problem eventually gives Augustinian scholarship a new and more reliable basis by critically identifying mere hypotheses as such and by outlining the firm ground more securely.},
	language = {en},
	urldate = {2026-09-06},
	booktitle = {Tractatio {Scripturarum}. {Philological}, {Exegetical}, {Rhetorical}, and {Theological} {Studies} on {Augustine}\&apos;s {Sermons}},
	publisher = {Brepols Online},
	author = {Drobner, Hubertus R.},
	month = jan,
	year = {2012},
	doi = {10.1484/M.IPM-EB.1.101272},
	pages = {97--116},
	file = {Snapshot:C\:\\Users\\U836185\\Zotero\\storage\\EQ9P5X45\\M.IPM-EB.1.html:text/html},
}

@incollection{drobner_treacherous_2022,
	title = {Treacherous transmission: {The} case of {Augustine}'s {Sermons} 151–156},
	shorttitle = {Treacherous transmission},
	abstract = {Augustine of Hippo’s writings are doubtlessly one of the major historical sources in the late fourth and early fifth centuries. In many respects they continue to define our perception of this period. Nevertheless, historical sources are always limited in their outlook and scope, often only partially preserved, and subject to the world view of both their authors and their recipients. For some 25 years now, an international discussion has been conducted on the validity of the transmission, chronology, and history of the largest single part of Augustine’s works: his sermons. Given the importance of Augustine’s voice, a thorough methodological analysis of the origin, transmission, and reception of his sermons seems to be essential for our overall understanding of late antiquity. Consequently, the chapter will address these questions on the basis of a number of well-selected examples from Augustine’s texts in order to highlight the conditions and pitfalls of using them as historical sources: (1) Augustine’s library as the presumed origin of Possidius’ Indiculus and mediaeval manuscript collections. (2) The composition of series of sermons in those collections. (3) The consequences for ascertaining Augustine’s course of life, his actions and movements, the liturgies of his times, and the development of his thought.},
	booktitle = {Making and {Unmaking} {Ancient} {Memory}},
	publisher = {Routledge},
	author = {Drobner, Hubertus R.},
	year = {2022},
	note = {Num Pages: 15},
}

