@article{denis_pseudo-augustinian_2024,
	title = {The pseudo-{Augustinian} {S}. {App}. 121 and its medieval textual connections: {A} testcase for the development of network visualizations in the {PASSIM} {Research} {Tool}},
	volume = {9},
	issn = {2535-8863},
	shorttitle = {The pseudo-{Augustinian} {S}. {App}. 121 and its medieval textual connections},
	url = {https://reference-global.com/article/10.25517/jhnr.v9i1.133},
	doi = {10.25517/jhnr.v9i1.133},
	abstract = {{\textless}p{\textgreater}This article investigates the benefits and challenges inherent in using networks to visualize and analyze the textual connections between Latin patristic sermons as transmitted in medieval manuscripts. Patristic sermons, which had a dynamic reception in the Middle Ages and were the subject of an extensive and complex scholarly tradition, are an ideal test case for an inquiry into the manipulations of texts as part of the process of textual transmission in the Middle Ages. Using the pseudo-Augustinian {\textless}em{\textgreater}sermo{\textless}/em{\textgreater} 121 as a case study, we will first describe the textual history of the sermon. Subsequently, we will translate this narrative of the scholarly history of PS-AU s 121 into network visualizations of increasing complexity and reflect on the accuracy, usefulness, and challenges of this method for the study of the myriad textual connections between patristic sermons in medieval contexts. This case study on network visualizations is part of a larger project to develop a digital application and database, the PASSIM Research Tool, to chart the dissemination and manipulation of patristic preaching in the Middle Ages.{\textless}/p{\textgreater}},
	language = {English},
	number = {1},
	urldate = {2026-09-04},
	journal = {Journal of Historical Network Research},
	publisher = {University of Luxembourg},
	author = {Denis, Iris and Boodts, Shari},
	month = feb,
	year = {2024},
	pages = {1--35},
	file = {Full Text PDF:C\:\\Users\\U836185\\Zotero\\storage\\YAHQC4K4\\Denis and Boodts - 2024 - The pseudo-Augustinian S. App. 121 and its medieval textual connections A testcase for the developm.pdf:application/pdf},
}

@article{weis_past_2025,
	title = {Past, {Present}, and {Future} of {HNR}: {Reflections} on the {Practices} and {Methods} in {Historical} {Network} {Research} {Based} on a {Quantitative} {Survey}},
	volume = {11},
	issn = {2535-8863},
	shorttitle = {Past, {Present}, and {Future} of {HNR}},
	url = {https://jhnr.net/articles/10.25517/jhnr.v11i1.103},
	doi = {10.25517/jhnr.v11i1.103},
	abstract = {The past, present, and future of Historical Network Research (HNR) is widely discussed.\&nbsp;While various contributions thoughtfully reflect on the potentials and pitfalls of new (computational) methods and their implications for wider epistemological assumptions, the current discussion seems to lack a review of the actual practices and methods in use when doing network-related historical research. By conducting a quantitative online survey within the HNR community, we add to this perspective and enrich the current debate by discussing recent developments in the field as well as challenges and wishes stated by the survey respondents.\&nbsp;We found that while methods from Social Network Analysis (SNA) are still prevalent within the field of HNR, there are also a variety of methodological approaches and thematic directions that extend beyond this. In the context of a broadening landscape of methods, the results underline the importance of developing common practices that facilitate data interoperability, resources fostering methodological literacy, as well as approaches for the fitting and validation of promising network analysis methods for various application scenarios in the historical sciences. Working towards a more practically grounded understanding of doing HNR may further advance the methodological and epistemological discussions within the community.\&nbsp;},
	language = {en},
	number = {1},
	urldate = {2026-09-04},
	journal = {Journal of Historical Network Research},
	author = {Weiß, Lea and Welczeck, Laura von and Vogl, Malte and Düring, Marten and Kaye, Aleksandra and Schmitz, Jascha Merijn and Schlattmann, Raphael and Buarque, Bernardo Sousa},
	month = jun,
	year = {2025},
	file = {Full Text PDF:C\:\\Users\\U836185\\Zotero\\storage\\F4DKMJG6\\Weiß et al. - 2025 - Past, Present, and Future of HNR Reflections on the Practices and Methods in Historical Network Res.pdf:application/pdf},
}

