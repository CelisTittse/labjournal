@incollection{macchioro_augustines_2025,
	title = {Augustine’s {Sermons} in the {Hands} of {Medieval} {Compilers}. {Notes} on the {Role} of {Sermones} ad {Populum} and {Tractatus} in {Iohannem} in the {Customization} of {Liturgical} {Sermon} {Collections}},
	url = {https://www.brepolsonline.net/content/books/10.1484/M.IPM-EB.5.142102},
	doi = {10.1484/M.IPM-EB.5.142102},
	abstract = {This paper analyzes the presence of Sermones ad Populum and Tractatus in Iohannem by Augustine of Hippo in selected influential patristic homiliaries of the Middle Ages. The purpose is to lay some groundwork to explore the attitude of medieval compilers towards Augustinian source material, and – more broadly – to address the pivotal problem of the relationships between the homiliaries and their (alleged) sources. The first section is devoted to the early medieval homiliaries of Alanus of Farfa and Paul the Deacon. After commenting on a striking difference between the two (Alanus contains several Sermones ad Populum, Paul very few), an attempt is made at evaluating on a textual basis whether Paul the Deacon could have employed Alanus’ homiliary as a source (an open problem in sermon studies, not yet adequately addressed via philological evidence). An in-depth textual analysis of a series of sermons by Leo the Great, and, especially, Caesarius of Arles’ sermon 227 and Eusebius Gallicanus’ sermon 47 leads to assume that Paul did not rely on Alanus directly, but rather drew independently on an earlier repository of material on which also Alanus relied. Furthermore, new insights are given into the transmission of CAE s. 227 and EUS-G s. 47 that challenge earlier scholarship on these texts. The second section takes into account the employment of the Tractatus in Iohannem to craft homiliaries. First, the focus is on the Sankt Gallen milieu. Here, in some homiliaries derived from Paul the Deacon, the Sermones ad populum appear to have been overlooked, while additional items with respect to the model are taken from the Tractatus and other Augustinian works. Then, the focus shifts to the Beneventan area, because in that environment Augustine’s Tractatus appear to have been widely employed in the construction of homiliaries. Moreover, there are recurrent series of excerptions from the same treatises that suggest the existence of a repository of material taken from the Tractatus and already customized for use in homiliaries. Finally, also some massive monastic sermon collections of French origin (the Lectionary of Cluny and the Lectionary of Corbie) encompass a large selection of pieces extracted from the Tractatus and thus confirm that this work played a significant role in the formation of homiliaries.},
	urldate = {2026-09-07},
	booktitle = {Vox praedicatoris},
	publisher = {Brepols Online},
	author = {Macchioro, Riccardo},
	month = jan,
	year = {2025},
	pages = {383--433},
	file = {PDF:C\:\\Users\\U836185\\Zotero\\storage\\3DCJJQFC\\Macchioro - 2025 - Augustine’s Sermons in the Hands of Medieval Compilers. Notes on the Role of Sermones ad Populum and.pdf:application/pdf;Snapshot:C\:\\Users\\U836185\\Zotero\\storage\\PRL52T4K\\M.IPM-EB.5.html:text/html},
}

